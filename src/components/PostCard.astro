---
import FormattedDate from './FormattedDate.astro';

interface Props {
  url: string;
  title: string;
  date: Date;
  description?: string;
  featuredimage?: string;
  tags?: string[];
  featured?: boolean;
}

const { url, title, date, description, featuredimage, tags = [], featured } =
  Astro.props;

// Card thumbnails are served from pre-generated WebP (scripts/gen-thumbs.mjs),
// sized close to their display size instead of the full-resolution original.
const base = featuredimage
  ?.split('/')
  .pop()
  ?.replace(/\.(png|jpe?g|webp|gif)$/i, '');
const thumb = base ? `/img/thumbs/${base}.webp` : undefined;
const coverLabel = tags[0] ?? 'Article';
---

<article class:list={['card', { featured }]}>
  <div class="card-media" aria-hidden="true">
    {
      thumb ? (
        <img
          src={thumb}
          alt=""
          width={featured ? 1000 : 760}
          height={featured ? 640 : 428}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="card-cover">
          <span class="card-cover-label">{coverLabel}</span>
        </div>
      )
    }
  </div>
  <div class="card-body">
    <div class="card-meta">
      <FormattedDate date={date} />
      {tags[0] && <span class="card-cat">{tags[0]}</span>}
    </div>
    <h3 class="card-title">
      <a href={url} class="card-link">{title}</a>
    </h3>
    {description && <p class="card-excerpt">{description}</p>}
    <span class="card-readmore" aria-hidden="true">Read more →</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .card::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--gradient);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
    z-index: 3;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }
  .card:hover::after { transform: scaleX(1); }

  .card-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-subtle);
    display: block;
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .card:hover .card-media img { transform: scale(1.04); }

  /* Designed cover for posts with no featured image */
  .card-cover {
    width: 100%;
    height: 100%;
    background: var(--gradient);
    background-size: 160% 160%;
    position: relative;
    display: grid;
    place-items: center;
  }
  .card-cover::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.18) 1px, transparent 1.5px);
    background-size: 16px 16px;
    opacity: 0.5;
  }
  .card-cover-label {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(2px);
  }

  .card-body {
    padding: 1.25rem 1.35rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .card-cat {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent);
    font-weight: 600;
  }
  .card-cat::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--gradient);
  }
  .card-title {
    font-size: 1.2rem;
    line-height: 1.3;
    margin: 0;
  }
  .card-title a { color: var(--text); }
  .card-title a:hover { color: var(--accent); }

  /* Stretched link: the title anchor is the card's single, named link */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .card-link:focus-visible {
    outline: none;
  }
  .card-link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: -3px;
    border-radius: var(--radius);
  }

  .card-excerpt {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-readmore {
    margin-top: auto;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    padding-top: 0.3rem;
  }

  .card.featured {
    grid-column: 1 / -1;
  }
  @media (min-width: 800px) {
    .card.featured {
      flex-direction: row;
    }
    .card.featured .card-media {
      flex: 0 0 48%;
      aspect-ratio: auto;
    }
    .card.featured .card-body {
      justify-content: center;
      padding: 2rem;
    }
    .card.featured .card-title { font-size: 1.6rem; }
  }
</style>
