---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <strong>{SITE_TITLE}</strong>
      <p>Regulated Azure platforms — compliant &amp; affordable.</p>
    </div>

    <div class="footer-social">
      <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener" aria-label="GitHub">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5A12 12 0 0 0 0 12.6c0 5.34 3.44 9.86 8.21 11.46.6.11.82-.26.82-.58v-2.03c-3.34.74-4.04-1.63-4.04-1.63-.55-1.4-1.34-1.78-1.34-1.78-1.09-.76.08-.74.08-.74 1.2.09 1.84 1.26 1.84 1.26 1.07 1.86 2.81 1.32 3.5 1.01.11-.79.42-1.32.76-1.62-2.67-.31-5.47-1.36-5.47-6.05 0-1.34.47-2.43 1.24-3.29-.12-.31-.54-1.55.12-3.23 0 0 1.01-.33 3.3 1.26a11.3 11.3 0 0 1 6.01 0c2.29-1.59 3.3-1.26 3.3-1.26.66 1.68.24 2.92.12 3.23.77.86 1.24 1.95 1.24 3.29 0 4.7-2.81 5.74-5.49 6.04.43.38.82 1.12.82 2.26v3.35c0 .32.21.7.82.58A12.03 12.03 0 0 0 24 12.6 12 12 0 0 0 12 .5z"/></svg>
      </a>
      <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
      </a>
      <a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener" aria-label="Twitter / X">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.6l5.24 6.93 6.06-6.93zm-1.29 19.5h2.04L6.48 3.24H4.3l13.31 17.41z"/></svg>
      </a>
      <a href={SOCIAL_LINKS.rss} aria-label="RSS feed">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
      </a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} {SITE_TITLE}. Built with Astro.</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
    padding-block: 2.5rem 1.5rem;
    margin-top: 4rem;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .footer-brand p {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .footer-social {
    display: flex;
    gap: 0.4rem;
  }
  .footer-social a {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 9px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    background: var(--bg);
    transition: all 0.15s ease;
  }
  .footer-social a:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .footer-bottom {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-faint);
    font-size: 0.875rem;
  }
</style>
