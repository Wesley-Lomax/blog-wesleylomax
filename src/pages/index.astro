---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getSortedPosts, postUrl } from '../utils';
import { SITE_DESCRIPTION } from '../consts';

const posts = await getSortedPosts();

// Split current writing from the older Sitecore/.NET archive so the home page
// leads with the Azure/compliance focus rather than the 2015–2019 back catalogue.
const RECENT_CUTOFF = new Date('2024-01-01');
const recent = posts.filter((p) => p.data.date >= RECENT_CUTOFF);
const archive = posts.filter((p) => p.data.date < RECENT_CUTOFF);

// Fall back to newest posts if there's no recent writing yet.
const current = recent.length ? recent : posts;
const [featured, ...moreRecent] = current;
const recentGrid = moreRecent.slice(0, 3);
const archiveShown = archive.slice(0, 3);
---

<BaseLayout title="Wesley Lomax" description={SITE_DESCRIPTION}>
  <section class="hero container">
    <p class="eyebrow">Managed Cloud · Azure · Compliance</p>
    <h1>
      I make regulated Azure platforms
      <span class="gradient-text">repeatable, compliant and affordable</span>.
    </h1>
    <p class="hero-sub">
      I run the Managed Cloud team at Sitecore, turning bespoke Azure engineering
      into repeatable services for regulated platforms. This is where I write
      about what makes that work: productising managed services, the AI
      automations that actually pay for themselves, and keeping an estate
      compliant and affordable at the same time.
    </p>
    <div class="hero-actions">
      <a href="/posts" class="btn btn-primary">Read the writing</a>
      <a href="/contact" class="btn">Get in touch</a>
    </div>
  </section>

  <section class="container feed">
    <div class="feed-head">
      <h2>Latest</h2>
      <a href="/posts" class="feed-all">All posts →</a>
    </div>

    <div class="grid">
      {
        featured && (
          <PostCard
            featured
            url={postUrl(featured)}
            title={featured.data.title}
            date={featured.data.date}
            description={featured.data.description}
            featuredimage={featured.data.featuredimage}
            tags={featured.data.tags}
          />
        )
      }
      {
        recentGrid.map((post) => (
          <PostCard
            url={postUrl(post)}
            title={post.data.title}
            date={post.data.date}
            description={post.data.description}
            featuredimage={post.data.featuredimage}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </section>

  {
    archiveShown.length > 0 && (
      <section class="container feed archive">
        <div class="feed-head">
          <div>
            <h2>From the archive</h2>
            <p class="feed-note">
              Earlier writing from my Sitecore and .NET years — kept here for
              reference.
            </p>
          </div>
          <a href="/posts" class="feed-all">Browse archive →</a>
        </div>

        <div class="grid">
          {archiveShown.map((post) => (
            <PostCard
              url={postUrl(post)}
              title={post.data.title}
              date={post.data.date}
              description={post.data.description}
              featuredimage={post.data.featuredimage}
              tags={post.data.tags}
            />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding-block: 3rem 2.5rem;
    max-width: 48rem;
  }
  .hero h1 {
    margin: 0.75rem 0 1rem;
  }
  .hero-sub {
    font-size: 1.2rem;
    color: var(--text-muted);
    margin: 0 0 1.75rem;
  }
  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .feed { padding-top: 1rem; }
  .feed.archive { padding-top: 2.5rem; }
  .feed-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .feed-head h2 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .feed-head h2::before {
    content: '';
    width: 0.5rem;
    height: 1.5rem;
    border-radius: 3px;
    background: var(--gradient);
  }
  .feed-note {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .feed-all { font-weight: 600; font-size: 0.95rem; white-space: nowrap; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
</style>
