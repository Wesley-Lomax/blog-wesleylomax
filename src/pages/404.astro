---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page could not be found.">
  <div class="container notfound">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p class="msg">
      The page you're after has moved or never existed. Let's get you back on track.
    </p>
    <div class="actions">
      <a href="/" class="btn btn-primary">Go home</a>
      <a href="/posts" class="btn">Browse posts</a>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding-block: 4rem 5rem;
  }
  .code {
    font-size: 5rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    margin: 0;
  }
  .notfound h1 { margin: 0.5rem 0 1rem; }
  .msg { color: var(--text-muted); max-width: 30rem; margin: 0 auto 1.75rem; }
  .actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
</style>
