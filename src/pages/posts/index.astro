---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts, postUrl } from '../../utils';

const posts = await getSortedPosts();
---

<BaseLayout
  title="Posts"
  description="Writing on Azure compliance, architecture, security and cost — plus the earlier Sitecore and .NET archive."
>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Archive</p>
      <h1>All posts</h1>
      <p class="page-sub">{posts.length} articles, newest first.</p>
    </header>

    <div class="grid">
      {
        posts.map((post) => (
          <PostCard
            url={postUrl(post)}
            title={post.data.title}
            date={post.data.date}
            description={post.data.description}
            featuredimage={post.data.featuredimage}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-head { margin-bottom: 2rem; }
  .page-head h1 { margin: 0.5rem 0 0.5rem; }
  .page-sub { color: var(--text-muted); margin: 0; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
</style>
